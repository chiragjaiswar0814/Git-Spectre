# ─────────────────────────────────────────────────────────────
# Git-Spectre — Environment Variables
# Copy this file to .env for local development.
# On Vercel: set these in Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# (Optional) Default GitHub Personal Access Token (PAT)
# Bumps the rate limit from 60 req/hr (unauthenticated) to 5,000 req/hr.
# Required scopes: none (public read is sufficient)
# Generate one at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_token_here

# (Optional) Comma-separated list of allowed CORS origins.
# Defaults to https://git-spectre.vercel.app and localhost variants.
# Override this in production with your actual domain(s).
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
